#Notes for the installer:
#   These values will change significantly based on your motor.
#   If you are using something like Nema 42 [The custom motor for high torque], do not give it a GEAR reduction!!!
#   Change stall detection based on the sheets that contains the encoder calibration.
#   T6 - False, T5 - True

# Motor/Mechanical Constants
MICROSTEPS=25_600.0
GEAR_REDUCTION=50.0
# CHANGE ME!
SLEW_BEARING=84.0
DEFAULT_MAX_SPEED_STEPS_PER_S=43_000.0
DEFAULT_ACCEL_STEPS_PER_S2=20_000
INVERT_MOTOR_DIRECTION=False #if dip-switch 9 and 10 are off
#   T6 - False, T5 - True

# Encoder Constants
ENC_TICKS_PER_REV=348_323.0

# Stall Detection
MAX_STEPS_WITHOUT_ENC_CHANGE=120_000

# Tracking Constants
TRACKING_DEADBAND_DEG=5.0
HOME_HEADING_DEG=90.0
HOME_ERROR_ACCEPTABLE_DEG=2.5

# Soft Limits (Safety Guardrails)
SOFT_LIMIT_MIN_DEG=50.0
SOFT_LIMIT_MAX_DEG=300.0

# Relay polarity (true = active high, false = active low)
RELAY_ACTIVE_HIGH=true

# Limit switch polarity (true = active high, false = active low)
LIMIT_SWITCH_ACTIVE_HIGH=false

# Encoder Overshoot Protection (Safety)
ENCODER_OVERSHOOT_TOLERANCE_TICKS=30_000
ENCODER_PROBE_STEPS=50_000
ENCODER_PROBE_MIN_TICKS=85

# Operational Mode
ACTIVE_PROFILE=Normal
ACTIVE_MODE=Normal

# Device identity (used as MQTT topic prefix: `tower/{DEVICE_ID}/...`)
DEVICE_ID=1

# WiFi Configuration
# CHANGE ME!
WIFI_SSID=foo
WIFI_PASSWORD=bar

# POSIX TZ for libc (DST); used by rtc crate / future tower time init (see tzset(3))
TZ_POSIX=CST6CDT,M3.2.0,M11.1.0

# Tower configuration
# CHANGE ME!
TOWER_LATITUDE=0.0
TOWER_LONGITUDE=0.0
