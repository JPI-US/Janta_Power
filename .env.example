#Notes for the installer:
#   These values will change significantly based on your motor.
#   If you are using something like Nema 42 [The custom motor for high torque], do not give it a GEAR reduction!!!
#   Change stall detection based on the sheets that contains the encoder calibration.

# Motor/Mechanical Constants
MICROSTEPS=25600.0
GEAR_REDUCTION=1.0
SLEW_BEARING=84.0
DEFAULT_MAX_SPEED_STEPS_PER_S=5000.0
DEFAULT_ACCEL_STEPS_PER_S2=200
INVERT_MOTOR_DIRECTION=true

# Encoder Constants
ENC_TICKS_PER_REV=348323.0

# Stall Detection
MAX_STEPS_WITHOUT_ENC_CHANGE=20000

# Tracking Constants
TRACKING_DEADBAND_DEG=5.0
HOME_HEADING_DEG=90.0

# Soft Limits (Safety Guardrails)
SOFT_LIMIT_MIN_DEG=0.0
SOFT_LIMIT_MAX_DEG=300.0

# Encoder Overshoot Protection (Safety)
ENCODER_OVERSHOOT_TOLERANCE_TICKS=800

# Operational Mode
# **Change this mode back to Normal after done testing, NEVER LEAVE THE SITE WITH DIAGNOSTIC MODE ON**
ACTIVE_PROFILE=Normal
ACTIVE_MODE=Normal

# WiFi Configuration
WIFI_SSID=
WIFI_PASSWORD=

#Mqtt Configuration
MQTT_USER=
MQTT_PASSWORD=

# Timezone
TIMEZONE_OFFSET_HOURS=-5.0
