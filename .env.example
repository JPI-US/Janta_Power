#Notes for the installer:
#   These values will change significantly based on your motor.
#   If you are using something like Nema 42 [The custom motor for high torque], do not give it a GEAR reduction!!!
#   Change stall detection based on the sheets that contains the encoder calibration.
#   T6 - False, T5 - True

# Motor/Mechanical Constants
MICROSTEPS=25_600.0
GEAR_REDUCTION=50.0
SLEW_BEARING=85.0
DEFAULT_MAX_SPEED_STEPS_PER_S=43_000.0
DEFAULT_ACCEL_STEPS_PER_S2=20_000
INVERT_MOTOR_DIRECTION=true #if dip-switch 9 and 10 are off


# Encoder Constants
ENC_TICKS_PER_REV=348_323.0

# Encoder Recovery
ENCODER_PROBE_STEPS=10000

# Stall Detection
MAX_STEPS_WITHOUT_ENC_CHANGE=120_000

# Tracking Constants
TRACKING_DEADBAND_DEG=5.0
HOME_HEADING_DEG=90.0
# Sunset homing drift threshold (abs degrees). Within +/- this value the drift
# is reported as "acceptable"; beyond it, "undershoot" (positive) or
# "overshoot" (negative) is published to tower/{id}/data/encoder_error_ticks.
HOME_ERROR_ACCEPTABLE_DEG=2.5

# Soft Limits (Safety Guardrails)
SOFT_LIMIT_MIN_DEG=0.0
SOFT_LIMIT_MAX_DEG=285.0

# Encoder Overshoot Protection (Safety)
ENCODER_OVERSHOOT_TOLERANCE_TICKS=1_000
ENCODER_PROBE_STEPS=50_000
ENCODER_PROBE_MIN_TICKS=80

# Temperature monitoring (HDC1080) — publish fault to MQTT above this (°F)
TEMP_FAULT_THRESHOLD_F=111.0

# Operational Mode
# **Change this mode back to Normal after done testing, NEVER LEAVE THE SITE WITH DIAGNOSTIC MODE ON**
ACTIVE_PROFILE=Normal
ACTIVE_MODE=Normal

# WiFi Configuration
WIFI_SSID=
WIFI_PASSWORD=

# POSIX TZ for libc (DST); used by rtc crate / future tower time init (see tzset(3))
TZ_POSIX=CST6CDT,M3.2.0,M11.1.0

# Tower location (used by switchboard; override in switchboard.rs for OTA if needed)
TOWER_LATITUDE=32.797868
TOWER_LONGITUDE=-96.835597