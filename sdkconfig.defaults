# Rust often needs a bit of an extra main task stack size compared to C (the default is 3K)
CONFIG_ESP_MAIN_TASK_STACK_SIZE=20000

# Use this to set FreeRTOS kernel tick frequency to 1000 Hz (100 Hz by default).
# This allows to use 1 ms granularity for thread sleeps (10 ms by default).
CONFIG_FREERTOS_HZ=1000

# Workaround for https://github.com/espressif/esp-idf/issues/7631
#CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=n
#CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=n

CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=n
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n
CONFIG_ESP_TASK_WDT_TIMEOUT_S=1800 # 30 minutes = 1,800 seconds. TODO: CHANGE WDT_TIMEOUT
CONFIG_ESP_TASK_WDT_PANIC=y

# Console routing is left at the ESP32-S3 default, on purpose.
#
# The generated config that results is:
#
#   CONFIG_ESP_CONSOLE_UART_DEFAULT=y                 primary console  -> UART0
#   CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y    secondary        -> USB Serial/JTAG
#
# so `log::*` output is mirrored onto the same USB Serial/JTAG wire the
# diagnostics protocol uses. That is why a host resolves a command only on its
# terminal `RESULT` line and ignores everything else it sees on the link.
#
# The diagnostics console does not depend on any of this. It calls
# `usb_serial_jtag_driver_install` and talks to the peripheral directly, which is
# independent of where ESP-IDF routes its console.
#
# Previously this file carried three lines meant to force the console onto USB
# Serial/JTAG:
#
#   CONFIG_ESP_CONSOLE_USB_CDC=n
#   CONFIG_USB_SERIAL_JTAG=y
#   CONFIG_ESP_CONSOLE_UART=n
#
# None of those are real, settable symbols. `CONFIG_USB_SERIAL_JTAG` does not
# exist (the console choice is `CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG`), and
# `CONFIG_ESP_CONSOLE_UART` is derived rather than set. They were silently
# ignored, and the generated sdkconfig was the default either way. Removed rather
# than corrected: the default is what the firmware has been tested against, so
# changing the routing here would be a change, not a fix.

#CONFIG_BT_ENABLED=y
#CONFIG_BT_BLE_ENABLED=y
#CONFIG_BT_BLUEDROID_ENABLED=n
#CONFIG_BT_NIMBLE_ENABLED=y
#CONFIG_BT_NIMBLE_50_FEATURE_SUPPORT=y
#CONFIG_BT_NIMBLE_EXT_ADV=y
#CONFIG_BT_NIMBLE_NVS_PERSIST=y
#CONFIG_BT_NIMBLE_ENABLE_CONN_REATTEMPT=n
