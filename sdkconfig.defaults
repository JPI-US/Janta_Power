# Rust often needs a bit of an extra main task stack size compared to C (the default is 3K)
CONFIG_ESP_MAIN_TASK_STACK_SIZE=20000

# Use this to set FreeRTOS kernel tick frequency to 1000 Hz (100 Hz by default).
# This allows to use 1 ms granularity for thread sleeps (10 ms by default).
CONFIG_FREERTOS_HZ=1000

# Workaround for https://github.com/espressif/esp-idf/issues/7631
#CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=n
#CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=n

CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=n
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n
CONFIG_ESP_TASK_WDT_TIMEOUT_S=1800 # 30 minutes = 1,800 seconds. TODO: CHANGE WDT_TIMEOUT
CONFIG_ESP_TASK_WDT_PANIC=y

# Pin PROJECT_VER to a short fixed string because git describe can exceed 24 chars and overflow the heapless::String<24> that EspOta::get_running_slot() uses, panicking boot validation.
CONFIG_APP_PROJECT_VER_FROM_CONFIG=y
CONFIG_APP_PROJECT_VER="1.1.4"

# App rollback support: after an OTA update, the new app boots marked invalid
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Board has 8MB flash. CONFIG_ESPTOOLPY_FLASHSIZE is derived from this choice
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"


